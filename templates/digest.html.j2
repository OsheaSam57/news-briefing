<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Morning Briefing</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Mono:wght@300;400&family=Syne:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #0b0d11;
      --surface: #13161d;
      --surface-2: #1a1e28;
      --border: rgba(255,255,255,0.07);
      --border-hi: rgba(255,255,255,0.13);
      --ink: #e8e4da;
      --ink-muted: #7a8094;
      --ink-faint: #3a3f50;
      --gold: #c9a84c;
      --gold-soft: rgba(201,168,76,0.12);
      --gold-glow: rgba(201,168,76,0.06);
      --teal: #2a8f7f;
      --blue: #3a6bbf;
      --violet: #7c5cbf;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Syne', Arial, sans-serif;
      background: var(--bg);
      color: var(--ink);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 0;
      opacity: 0.6;
    }

    .layout {
      display: grid;
      grid-template-columns: 220px 1fr;
      min-height: 100vh;
      position: relative;
      z-index: 1;
    }

    .sidebar {
      border-right: 1px solid var(--border);
      padding: 36px 0;
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }

    .sidebar-logo {
      padding: 0 24px 32px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 24px;
    }

    .sidebar-logo .mark {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22px;
      font-weight: 300;
      letter-spacing: 0.04em;
      color: var(--ink);
      line-height: 1.2;
    }

    .sidebar-logo .mark em {
      font-style: italic;
      color: var(--gold);
    }

    .sidebar-logo .sub,
    .nav-label,
    .stat-row .k,
    .stat-row .v,
    .nav-count,
    .source-tag,
    .score-badge,
    .theme-tag,
    .callout-label,
    .ticker-item,
    .ticker-label,
    .masthead-meta,
    .eyebrow-text {
      font-family: 'DM Mono', monospace;
    }

    .sidebar-logo .sub {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-muted);
      margin-top: 4px;
    }

    .nav-label {
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-faint);
      padding: 0 24px 10px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 24px;
      font-size: 13px;
      font-weight: 500;
      color: var(--ink-muted);
      text-decoration: none;
      transition: color 0.15s, background 0.15s;
      border-left: 2px solid transparent;
    }

    .nav-item:hover,
    .nav-item.active {
      color: var(--ink);
      background: var(--gold-glow);
      border-left-color: var(--gold);
    }

    .nav-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .nav-count {
      margin-left: auto;
      font-size: 11px;
      color: var(--ink-faint);
    }

    .sidebar-stats {
      margin-top: auto;
      padding: 24px;
      border-top: 1px solid var(--border);
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding: 6px 0;
      border-bottom: 1px solid var(--border);
    }

    .stat-row:last-child { border-bottom: none; }

    .stat-row .k {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    .stat-row .v {
      font-size: 14px;
      color: var(--gold);
    }

    .main {
      min-width: 0;
    }

    .masthead {
      padding: 48px 56px 40px;
      border-bottom: 1px solid var(--border);
      position: relative;
      overflow: hidden;
    }

    .masthead::after {
      content: '';
      position: absolute;
      top: -60px;
      right: -60px;
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(201,168,76,0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    .masthead-eyebrow {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
    }

    .pulse {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--gold);
      position: relative;
    }

    .pulse::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      border: 1px solid var(--gold);
      animation: pulse-ring 2s ease-out infinite;
    }

    @keyframes pulse-ring {
      0% { opacity: 0.8; transform: scale(1); }
      100% { opacity: 0; transform: scale(2.2); }
    }

    .eyebrow-text {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
    }

    .masthead h1 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 300;
      font-size: clamp(2.8rem, 5vw, 4.4rem);
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--ink);
    }

    .masthead h1 em {
      font-style: italic;
      color: var(--gold);
    }

    .masthead-meta {
      margin-top: 16px;
      font-size: 11px;
      color: var(--ink-muted);
      letter-spacing: 0.06em;
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .masthead-meta span::before {
      content: '—';
      margin-right: 8px;
      color: var(--ink-faint);
    }

    .ticker-wrap {
      border-bottom: 1px solid var(--border);
      background: var(--surface);
      overflow: hidden;
      height: 34px;
      display: flex;
      align-items: center;
    }

    .ticker-label {
      flex-shrink: 0;
      padding: 0 16px;
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bg);
      background: var(--gold);
      height: 100%;
      display: flex;
      align-items: center;
    }

    .ticker-track {
      display: flex;
      gap: 48px;
      animation: ticker 28s linear infinite;
      white-space: nowrap;
      padding-left: 32px;
    }

    @keyframes ticker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    .ticker-item {
      font-size: 11px;
      color: var(--ink-muted);
      letter-spacing: 0.04em;
    }

    .ticker-item strong {
      color: var(--ink);
      margin-right: 6px;
    }

    .sections {
      padding: 40px 56px 64px;
      display: flex;
      flex-direction: column;
      gap: 56px;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
    }

    .section-pip {
      width: 10px;
      height: 10px;
      border-radius: 2px;
      flex-shrink: 0;
    }

    .section-header h2 {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .section-line {
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .section-count {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      color: var(--ink-faint);
    }

    .grid {
      display: grid;
      gap: 16px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px 28px;
      position: relative;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
      animation: fade-up 0.4s ease both;
    }

    .card:hover {
      border-color: var(--border-hi);
      transform: translateY(-2px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    }

    @keyframes fade-up {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card:nth-child(1) { animation-delay: 0.05s; }
    .card:nth-child(2) { animation-delay: 0.10s; }
    .card:nth-child(3) { animation-delay: 0.15s; }
    .card:nth-child(4) { animation-delay: 0.20s; }

    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .card:hover::before { opacity: 1; }

    .domain-econ .card::before { background: linear-gradient(90deg, var(--gold), transparent); }
    .domain-ins .card::before { background: linear-gradient(90deg, var(--teal), transparent); }
    .domain-ai .card::before { background: linear-gradient(90deg, var(--violet), transparent); }
    .domain-ds .card::before { background: linear-gradient(90deg, var(--blue), transparent); }

    .card-top {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }

    .source-tag {
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 9px;
      border-radius: 4px;
      border: 1px solid var(--border-hi);
      color: var(--ink-muted);
    }

    .score-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: var(--ink-muted);
    }

    .score-bar {
      width: 52px;
      height: 3px;
      background: var(--surface-2);
      border-radius: 2px;
      overflow: hidden;
    }

    .score-fill {
      height: 100%;
      border-radius: 2px;
      background: var(--gold);
    }

    .score-num { color: var(--gold); }

    .theme-tags {
      margin-left: auto;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .theme-tag {
      font-size: 9px;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
      padding: 2px 7px;
      border: 1px solid var(--border);
      border-radius: 3px;
    }

    .card h3 {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 500;
      font-size: 1.35rem;
      line-height: 1.35;
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }

    .card h3 a {
      color: var(--ink);
      text-decoration: none;
      background-image: linear-gradient(var(--gold), var(--gold));
      background-size: 0 1px;
      background-repeat: no-repeat;
      background-position: 0 100%;
      transition: background-size 0.25s;
    }

    .card h3 a:hover { background-size: 100% 1px; }

    .summary {
      font-size: 0.92rem;
      line-height: 1.75;
      color: #a8b0c2;
      font-weight: 400;
    }

    .callout {
      margin-top: 18px;
      padding: 16px 18px;
      background: var(--gold-soft);
      border: 1px solid rgba(201,168,76,0.2);
      border-radius: 8px;
    }

    .callout-header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }

    .callout-icon {
      font-size: 13px;
    }

    .callout-label {
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--gold);
    }

    .callout p {
      font-size: 0.87rem;
      line-height: 1.7;
      color: #c4a85a;
    }

    .empty {
      padding: 32px;
      border: 1px dashed var(--border);
      border-radius: 12px;
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      color: var(--ink-faint);
      letter-spacing: 0.06em;
      text-align: center;
    }

    .pip-econ, .dot-econ { background: var(--gold); }
    .pip-ins, .dot-ins { background: var(--teal); }
    .pip-ai, .dot-ai { background: var(--violet); }
    .pip-ds, .dot-ds { background: var(--blue); }

    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--ink-faint); border-radius: 3px; }

    @media (max-width: 840px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: static;
        height: auto;
        flex-direction: row;
        flex-wrap: wrap;
        padding: 16px;
        gap: 8px;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }

      .sidebar-logo,
      .sidebar-stats,
      .nav-label {
        display: none;
      }

      .nav-item {
        border-left: none;
        border-bottom: 2px solid transparent;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
      }

      .nav-item:hover,
      .nav-item.active {
        border-bottom-color: var(--gold);
        border-left-color: transparent;
      }

      .masthead {
        padding: 28px 24px;
      }

      .sections {
        padding: 24px 24px 48px;
      }

      .theme-tags {
        margin-left: 0;
        width: 100%;
      }
    }
  </style>
</head>

<body>

{% set total_articles = namespace(count=0) %}
{% set total_callouts = namespace(count=0) %}

{% for section in sections %}
  {% set total_articles.count = total_articles.count + (section.articles | default([]) | length) %}
  {% for article in section.articles | default([]) %}
    {% if article.insurance_callout | default('') %}
      {% set total_callouts.count = total_callouts.count + 1 %}
    {% endif %}
  {% endfor %}
{% endfor %}

<div class="layout">

  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="mark">Morning<br/><em>Briefing</em></div>
      <div class="sub">Intelligence Digest</div>
    </div>

    <div class="nav-label">Domains</div>

    {% for section in sections %}
      {% set domain = 'ds' %}
      {% if 'Econ' in section.name or 'Market' in section.name %}
        {% set domain = 'econ' %}
      {% elif 'Insur' in section.name or 'Actuar' in section.name %}
        {% set domain = 'ins' %}
      {% elif 'AI' in section.name or 'ML' in section.name %}
        {% set domain = 'ai' %}
      {% endif %}

      <a class="nav-item {% if loop.first %}active{% endif %}" href="#section-{{ loop.index }}">
        <span class="nav-dot dot-{{ domain }}"></span>
        {{ section.name }}
        <span class="nav-count">{{ section.articles | default([]) | length }}</span>
      </a>
    {% endfor %}

    <div class="sidebar-stats">
      <div class="stat-row">
        <span class="k">Domains</span>
        <span class="v">{{ sections | length }}</span>
      </div>
      <div class="stat-row">
        <span class="k">Surfaced</span>
        <span class="v">{{ total_articles.count }}</span>
      </div>
      <div class="stat-row">
        <span class="k">Ins. flags</span>
        <span class="v">{{ total_callouts.count }}</span>
      </div>
    </div>
  </aside>

  <main class="main">

    <header class="masthead">
      <div class="masthead-eyebrow">
        <div class="pulse"></div>
        <span class="eyebrow-text">AI-Powered &nbsp;·&nbsp; Daily Intelligence</span>
      </div>
      <h1>Morning<br/><em>Briefing</em></h1>
      <div class="masthead-meta">
        <span>AI / ML</span>
        <span>Data Science</span>
        <span>Insurance &amp; Actuarial</span>
        <span>Economics &amp; Markets</span>
      </div>
    </header>

    {% if total_articles.count > 0 %}
    <div class="ticker-wrap">
      <div class="ticker-label">Brief</div>
      <div class="ticker-track">
        {% for repeat in range(2) %}
          {% for section in sections %}
            {% for article in section.articles | default([]) %}
              <span class="ticker-item">
                <strong>{{ section.name }}</strong>{{ article.title | default('Untitled article') }}
              </span>
            {% endfor %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="sections">
      {% for section in sections %}
        {% set domain = 'ds' %}
        {% if 'Econ' in section.name or 'Market' in section.name %}
          {% set domain = 'econ' %}
        {% elif 'Insur' in section.name or 'Actuar' in section.name %}
          {% set domain = 'ins' %}
        {% elif 'AI' in section.name or 'ML' in section.name %}
          {% set domain = 'ai' %}
        {% endif %}

        <section id="section-{{ loop.index }}" class="domain-{{ domain }}">
          <div class="section-header">
            <div class="section-pip pip-{{ domain }}"></div>
            <h2>{{ section.name }}</h2>
            <div class="section-line"></div>
            <span class="section-count">{{ section.articles | default([]) | length }} articles</span>
          </div>

          {% if section.articles %}
            <div class="grid">
              {% for article in section.articles %}
                {% set score = article.score | default(0) | float %}
                {% set score_width = score * 10 %}
                {% if score_width < 0 %}
                  {% set score_width = 0 %}
                {% elif score_width > 100 %}
                  {% set score_width = 100 %}
                {% endif %}

                <article class="card">
                  <div class="card-top">
                    <span class="source-tag">{{ article.source | default('Unknown source') }}</span>

                    <div class="score-badge">
                      <div class="score-bar">
                        <div class="score-fill" style="width: {{ score_width }}%"></div>
                      </div>
                      <span class="score-num">{{ "%.1f"|format(score) }}</span>
                      <span>/10</span>
                    </div>

                    {% set raw_themes = article.key_themes | default([], true) %}
                    {% if raw_themes is string %}
                      {% set theme_list = raw_themes.split(',') %}
                    {% else %}
                      {% set theme_list = raw_themes %}
                    {% endif %}

                    {% if theme_list %}
                      <div class="theme-tags">
                        {% for tag in theme_list %}
                          {% set tag = tag | trim %}
                          {% if tag %}
                            <span class="theme-tag">{{ tag }}</span>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>

                  <h3>
                    <a href="{{ article.url | default('#') }}" target="_blank" rel="noopener noreferrer">
                      {{ article.title | default('Untitled article') }}
                    </a>
                  </h3>

                  <p class="summary">{{ article.summary | default('No summary available.') }}</p>

                  {% if article.insurance_callout | default('') %}
                    <div class="callout">
                      <div class="callout-header">
                        <span class="callout-icon">⬡</span>
                        <span class="callout-label">Automotive &amp; Protection Relevance</span>
                      </div>
                      <p>{{ article.insurance_callout }}</p>
                    </div>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="empty">No qualifying articles in this section today</div>
          {% endif %}
        </section>
      {% endfor %}
    </div>

  </main>
</div>

</body>
</html>
