<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daily News Briefing</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f1e8;
        --panel: #fffdfa;
        --ink: #1e2430;
        --muted: #667085;
        --accent: #9f3a2f;
        --accent-soft: #f2d6cc;
        --border: #e7dccd;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        background:
          radial-gradient(circle at top left, rgba(159, 58, 47, 0.12), transparent 34%),
          linear-gradient(180deg, #f8f5ef 0%, var(--bg) 100%);
        color: var(--ink);
      }

      .page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 48px 20px 64px;
      }

      .hero {
        padding: 24px 0 32px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 12px;
        padding: 6px 10px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font: 600 12px/1.2 Arial, sans-serif;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0 0 8px;
        font-size: clamp(2.1rem, 5vw, 3.8rem);
        line-height: 1;
      }

      .hero p {
        margin: 0;
        max-width: 780px;
        color: var(--muted);
        font: 400 1rem/1.6 Arial, sans-serif;
      }

      section {
        margin-bottom: 28px;
      }

      h2 {
        margin: 0 0 16px;
        font-size: 1.7rem;
      }

      .grid {
        display: grid;
        gap: 18px;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 18px 40px rgba(30, 36, 48, 0.06);
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 12px;
        color: var(--muted);
        font: 600 0.86rem/1.2 Arial, sans-serif;
      }

      .score {
        color: var(--accent);
      }

      h3 {
        margin: 0 0 12px;
        font-size: 1.25rem;
        line-height: 1.3;
      }

      h3 a {
        color: inherit;
        text-decoration: none;
      }

      h3 a:hover {
        color: var(--accent);
      }

      .summary,
      .callout,
      .empty {
        margin: 0;
        font: 400 1rem/1.7 Arial, sans-serif;
      }

      .callout {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        color: #4d2b25;
      }

      .empty {
        color: var(--muted);
        background: rgba(255, 255, 255, 0.7);
        border-radius: 16px;
        padding: 20px;
      }

      @media (max-width: 640px) {
        .page {
          padding: 32px 14px 48px;
        }

        .card {
          padding: 16px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="hero">
        <span class="eyebrow">Personal Digest</span>
        <h1>AI-Powered News Briefing</h1>
        <p>
          A daily digest across AI/ML, Data Science, Insurance/Actuarial, and Economics/Markets.
        </p>
      </header>

      {% for section in sections %}
      <section>
        <h2>{{ section.name }}</h2>
        {% if section.articles %}
        <div class="grid">
          {% for article in section.articles %}
          <article class="card">
            <div class="meta">
              <span>{{ article.source }}</span>
              <span class="score">Relevance {{ article.score }}/10</span>
            </div>
            <h3><a href="{{ article.url }}" target="_blank" rel="noreferrer">{{ article.title }}</a></h3>
            <p class="summary">{{ article.summary }}</p>
            {% if article.insurance_callout %}
            <p class="callout">{{ article.insurance_callout }}</p>
            {% endif %}
          </article>
          {% endfor %}
        </div>
        {% else %}
        <p class="empty">No qualifying articles were available in this section for this run.</p>
        {% endif %}
      </section>
      {% endfor %}
    </main>
  </body>
</html>
